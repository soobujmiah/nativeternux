{
  "schema_version": 1,
  "profile_id": "ternuxx-debian-trixie-workstation",
  "provider": "proot-distro",
  "distro": "debian",
  "release": "trixie",
  "architecture": "aarch64",
  "lifecycle_owner": "ternuxx",
  "rootfs_policy": {
    "existing": "adopt-in-place; never reinstall, reset, or replace",
    "missing": "create only through an explicit preview-confirmed Ternuxx setup"
  },
  "guest": {
    "user": "required-install-input",
    "locale": "en_US.UTF-8",
    "startup_files": "do-not-edit",
    "audio_client": "receive authenticated Native PulseAudio settings from Ternuxx at launch"
  },
  "packages": {
    "base": [
      "ca-certificates",
      "dbus-x11",
      "libgl1-mesa-dri",
      "libvulkan1",
      "locales",
      "mesa-utils",
      "pulseaudio-utils",
      "sudo",
      "vulkan-tools",
      "x11-utils",
      "xauth",
      "xfce4",
      "xfce4-terminal"
    ],
    "desktop-compat": [
      "colord",
      "nano",
      "polkitd"
    ],
    "development": [
      "bats",
      "cargo",
      "cmake",
      "git",
      "gh",
      "jq",
      "libheif-dev",
      "ninja-build",
      "nodejs",
      "npm",
      "openjdk-21-jdk-headless",
      "openssh-client",
      "pkg-config",
      "python3-numpy",
      "python3-venv",
      "rustc",
      "tmux"
    ],
    "desktop-apps": [
      "7zip",
      "blender",
      "ffmpeg",
      "firefox-esr",
      "poppler-utils",
      "unrar-free",
      "unzip",
      "vlc",
      "xarchiver",
      "zip"
    ],
    "fonts": [
      "fonts-beng-extra",
      "fonts-font-awesome",
      "fonts-noto-color-emoji",
      "fonts-noto-core",
      "fonts-powerline",
      "fonts-symbola"
    ]
  },
  "graphics": {
    "backend": "zink-turnip",
    "open_gl_environment": {
      "MESA_LOADER_DRIVER_OVERRIDE": "zink",
      "GALLIUM_DRIVER": "zink",
      "TU_DEBUG": "sysmem,noconform",
      "MESA_VK_WSI_DEBUG": "sw",
      "MESA_SHADER_CACHE_DISABLE": "true"
    },
    "turnip_archive": {
      "url": "https://github.com/lfdevs/mesa-for-android-container/releases/download/mesa-26.3.0-devel-20260824/mesa-for-android-container_26.3.0-devel-20260824_debian_trixie_arm64.tar.gz",
      "sha256": "c014cf66bdbff96417ee30d34f006cf51df64ae04893d599711b0b6b73b52ccf",
      "upstream_commit": "98f3d6229d",
      "driver_member": "usr/lib/aarch64-linux-gnu/libvulkan_freedreno.so",
      "driver_sha256": "7ece28e1132cf791b6c81d4060142ff1481a239349fa86d7556c0883184caa5d",
      "icd_member": "usr/share/vulkan/icd.d/freedreno_icd.aarch64.json",
      "icd_sha256": "c9682812b58deb347fdeaa0fb3e5975651e20d37d31c682b2e5a7ed76ce348ae"
    },
    "managed_install_paths": {
      "driver": "/usr/local/lib/aarch64-linux-gnu/libvulkan_freedreno.so",
      "icd": "/usr/local/share/vulkan/icd.d/ternuxx_freedreno_icd.json"
    },
    "hold_packages": [
      "libegl-mesa0",
      "libgbm1",
      "libgl1-mesa-dri",
      "libglx-mesa0",
      "mesa-vulkan-drivers"
    ]
  },
  "native_handoff": {
    "display": "explicit Ternuxx session display",
    "pulse_server": "tcp:127.0.0.1:4713",
    "pulse_authentication": "private Ternuxx-managed cookie; never store in this manifest",
    "guest_abi": "glibc",
    "native_bionic_libraries_allowed": false
  },
  "legacy_ternux_cli": {
    "required_for_new_install": false,
    "remove_from_existing_install_only_after": "Ternuxx setup and workload verification plus a preview-bound exact-file removal"
  }
}
