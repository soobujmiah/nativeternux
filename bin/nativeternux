#!/data/data/com.termux/files/usr/bin/bash
# Backward-compatible command alias. Ternuxx is the canonical CLI.
set -u
script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)" || exit 1
for candidate in \
  "$script_dir/ternuxx" \
  "${PREFIX:-/data/data/com.termux/files/usr}/bin/ternuxx" \
  "$HOME/.local/bin/ternuxx"; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done
printf '%s\n' 'Ternuxx CLI was not found; run bin/ternuxx from a complete checkout or install the Ternuxx command.' >&2
exit 127
