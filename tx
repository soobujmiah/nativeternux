#!/usr/bin/env sh
# Ternuxx command line: tx <command> [options]
set -u
repo_dir="$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)" || exit 1
bash_bin="${PREFIX:+$PREFIX/bin/bash}"
if [ -z "$bash_bin" ] || [ ! -x "$bash_bin" ]; then
  bash_bin="$(command -v bash 2>/dev/null || true)"
fi
if [ -x "$repo_dir/bin/tx" ] && [ -n "$bash_bin" ] && [ -x "$bash_bin" ]; then
  exec "$bash_bin" "$repo_dir/bin/tx" "$@"
fi
printf '%s\n' 'Run this command from a complete Ternuxx checkout with Bash available.' >&2
exit 127
