#!/data/data/com.termux/files/usr/bin/bash
# Native Ternuxx-owned OpenSSH instance. runsv owns this foreground wrapper.
set -u
umask 077

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:?Termux HOME is required}"
TERMUX_VERSION="${TERMUX_VERSION:-unknown}"
TERNUXX_STATE_DIR="${TERNUXX_STATE_DIR:-$HOME/.local/share/ternuxx}"
CONFIG="$HOME/.config/ternuxx/sshd_recovery.conf"
LOG_DIR="$TERNUXX_STATE_DIR/log"
LOG_FILE="$LOG_DIR/sshd-runit.log"
export PREFIX HOME TERMUX_VERSION TERNUXX_STATE_DIR
export PATH="$PREFIX/bin:$PATH"

mkdir -p "$LOG_DIR" || exit 1
chmod 700 "$TERNUXX_STATE_DIR" "$LOG_DIR" 2>/dev/null || true
exec >>"$LOG_FILE" 2>&1
printf 'wrapper-started-at=%s pid=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$"

WAKELOCK_ACQUIRED=0
acquire_response=$(TERNUXX_JSON=1 "$PREFIX/bin/bash" "$PREFIX/bin/tx" wakelock acquire native.sshd --persistent) || {
  printf 'wakelock-acquire=failed-at-%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  exit 1
}
lease_state=$(printf '%s' "$acquire_response" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("data",{}).get("state", ""))') || exit 1
case "$lease_state" in
  acquired|already_acquired)
    WAKELOCK_ACQUIRED=1
    printf 'wakelock-acquire=ok-at-%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" ;;
  policy_disabled)
    printf 'wakelock-acquire=skipped-by-service-policy-at-%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" ;;
  *)
    printf 'wakelock-acquire=unverified-at-%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    exit 1 ;;
esac

child=""
cleanup() {
  trap - TERM INT EXIT
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
  fi
  if [ "$WAKELOCK_ACQUIRED" -eq 1 ]; then
    "$PREFIX/bin/bash" "$PREFIX/bin/tx" wakelock release native.sshd --persistent >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT
trap 'exit 0' TERM INT

if [ ! -r "$CONFIG" ] || ! "$PREFIX/bin/sshd" -t -f "$CONFIG"; then
  printf 'sshd config validation failed at %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$LOG_FILE"
  exit 1
fi

"$PREFIX/bin/sshd" -D -e -f "$CONFIG" >>"$LOG_FILE" 2>&1 &
child=$!
wait "$child"
status=$?
exit "$status"
