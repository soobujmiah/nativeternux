{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ternuxx:schema:verification-evidence:v1",
  "title": "Ternuxx verification evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "generated_at", "repository", "source_commit", "worktree_state", "scope", "tests", "suite_summary", "live_device", "rollback", "next_action"],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository": {"const": "soobujmiah/ternuxx"},
    "source_commit": {"type": "string", "pattern": "^[a-fA-F0-9]{7,64}$"},
    "worktree_state": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "component", "environment", "test_case", "method", "expected", "actual", "status", "evidence", "uncertainty"],
        "properties": {
          "requirement_id": {"type": "string"},
          "component": {"type": "string"},
          "environment": {"type": "string"},
          "test_case": {"type": "string"},
          "method": {"type": "string"},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "NOT_RUN"]},
          "evidence": {"type": "string"},
          "uncertainty": {"type": "string"}
        }
      }
    },
    "suite_summary": {
      "type": "object",
      "required": ["command", "passed", "failed", "status"],
      "properties": {
        "command": {"type": "string"},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "status": {"enum": ["PASS", "FAIL", "PARTIAL", "NOT_RUN"]}
      }
    },
    "live_device": {"type": "object"},
    "rollback": {"type": "object"},
    "next_action": {"type": "string"}
  }
}
