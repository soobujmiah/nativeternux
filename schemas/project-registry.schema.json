{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repo-Knowledge Project State (.repo/project.yaml)",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "repository",
    "generated_at",
    "generated_by",
    "head",
    "build",
    "test",
    "sync"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "head": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "committed_at"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "branch": {
          "type": "string"
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "not_configured",
            ".repo/phases.yaml",
            "docs/PHASES.md"
          ]
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active": {
          "type": [
            "string",
            "null"
          ]
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "completed",
                  "in_progress",
                  "active",
                  "blocked",
                  "not_started",
                  "deferred"
                ]
              },
              "gate": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "completed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "run_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocker_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "cancelled",
            "skipped",
            "timed_out",
            "unknown"
          ]
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped",
            "timed_out",
            "action_required",
            "neutral",
            "stale",
            "startup_failure",
            "unknown",
            null
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_attempt": {
          "type": "string"
        },
        "workflow_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp_source": {
          "enum": [
            "ci",
            "observed",
            "commit"
          ]
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "cancelled",
            "skipped",
            "timed_out",
            "unknown"
          ]
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped",
            "timed_out",
            "action_required",
            "neutral",
            "stale",
            "startup_failure",
            "unknown",
            null
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_attempt": {
          "type": "string"
        },
        "workflow_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp_source": {
          "enum": [
            "ci",
            "observed",
            "commit"
          ]
        }
      },
      "additionalProperties": false
    },
    "last_successful_build": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "commit",
        "at"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_attempt": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "last_failed_build": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "commit",
        "at"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_attempt": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "sync": {
      "type": "object",
      "required": [
        "status",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "pending",
            "failed",
            "never"
          ]
        },
        "last_synced_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_attempted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "state_version": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "source": {
          "enum": [
            "local",
            "ci",
            "manual"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
