{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soobujmiah/ternuxx/blob/main/schemas/boot-profile-action.schema.json",
  "title": "Ternuxx preview-first boot profile enable/disable result",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "schema_version",
        "requested_profile",
        "configured_profile",
        "configuration_source",
        "ready",
        "readiness_scope",
        "blockers",
        "actions",
        "generated_script",
        "managed_script_path",
        "boot_app_status",
        "requires_confirmation",
        "changed",
        "safety",
        "managed_script_identity"
      ],
      "properties": {
        "component": {
          "const": "boot_profile_preview"
        },
        "schema_version": {
          "const": 2
        },
        "requested_profile": {
          "enum": [
            "cli-only",
            "native"
          ]
        },
        "configured_profile": {
          "enum": [
            "cli-only",
            "native"
          ]
        },
        "configuration_source": {
          "enum": [
            "default",
            "configured"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "readiness_scope": {
          "type": "string"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_script": {
          "type": "string"
        },
        "managed_script_path": {
          "type": "string"
        },
        "boot_app_status": {
          "enum": [
            "installed",
            "not_installed",
            "unknown"
          ]
        },
        "requires_confirmation": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_only",
            "script_installed",
            "boot_config_changed",
            "silent_provider_fallback"
          ],
          "properties": {
            "read_only": {
              "type": "boolean"
            },
            "script_installed": {
              "type": "boolean"
            },
            "boot_config_changed": {
              "type": "boolean"
            },
            "silent_provider_fallback": {
              "const": false
            }
          }
        },
        "managed_script_identity": {
          "enum": [
            "not_checked",
            "not_configured",
            "match",
            "legacy_match",
            "missing",
            "mismatch",
            "unsafe"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "schema_version",
        "configured_profile",
        "configuration_source",
        "script_path",
        "script_present",
        "requires_confirmation",
        "changed",
        "safety"
      ],
      "properties": {
        "component": {
          "const": "boot_profile_disable"
        },
        "schema_version": {
          "const": 1
        },
        "configured_profile": {
          "enum": [
            "cli-only",
            "native"
          ]
        },
        "configuration_source": {
          "enum": [
            "default",
            "configured"
          ]
        },
        "script_path": {
          "type": "string"
        },
        "script_present": {
          "type": "boolean"
        },
        "requires_confirmation": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_only",
            "script_removed",
            "only_owned_paths"
          ],
          "properties": {
            "read_only": {
              "type": "boolean"
            },
            "script_removed": {
              "type": "boolean"
            },
            "only_owned_paths": {
              "const": true
            }
          }
        }
      }
    }
  ]
}
