{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ternuxx:schema:wakelock-owner-state:v1",
  "title": "Ternuxx native Wake Lock owner state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "boot_id", "owners", "last_error"],
  "properties": {
    "schema_version": {"const": 1},
    "boot_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 80}]},
    "last_error": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 160}]},
    "owners": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pid", "process_start", "persistent", "reason"],
        "properties": {
          "pid": {"type": "integer", "minimum": 2},
          "process_start": {"type": "string", "minLength": 1, "maxLength": 32},
          "persistent": {"type": "boolean"},
          "reason": {"type": "string", "maxLength": 120}
        }
      }
    }
  }
}
