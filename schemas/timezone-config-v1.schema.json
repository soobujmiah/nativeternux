{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ternuxx.local/schemas/timezone-config-v1.schema.json",
  "title": "Ternuxx timezone preference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timezone",
    "source",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)*$"
    },
    "source": {
      "enum": [
        "user",
        "installation"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
