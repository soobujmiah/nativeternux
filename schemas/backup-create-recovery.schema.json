{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soobujmiah/ternuxx/blob/main/schemas/backup-create-recovery.schema.json",
  "title": "Interrupted backup creation recovery response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "record_kind", "record_updated_at", "backup_id", "archive_path", "archive_integrity", "archive_sha256", "affected_paths", "resolution", "plan_id", "requires_confirmation", "changed", "read_only", "impact"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "record_kind": {"const": "recovery.backup.create"},
        "record_updated_at": {"type": "string", "format": "date-time"},
        "backup_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "archive_path": {"type": "string", "minLength": 1},
        "archive_integrity": {"enum": ["valid", "absent"]},
        "archive_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "affected_paths": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "resolution": {"enum": ["complete", "failed"]},
        "plan_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "requires_confirmation": {"const": true}, "changed": {"const": false}, "read_only": {"const": true}, "impact": {"type": "string"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "backup_id", "resolution", "changed", "read_only", "affected_paths", "archive_changed"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "backup_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "resolution": {"enum": ["complete", "failed"]},
        "changed": {"const": true}, "read_only": {"const": false},
        "affected_paths": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "archive_changed": {"const": false}
      }
    }
  ]
}
