#!/data/data/com.termux/files/usr/bin/bash
# Backward-compatible standalone command alias for Ternuxx.
set -u
root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)" || exit 1
if [ -x "$root/ternuxx" ]; then
  exec "$root/ternuxx" "$@"
fi
printf '%s\n' 'Ternuxx command not found; run ./ternuxx from the project checkout.' >&2
exit 127
